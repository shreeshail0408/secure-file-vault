# Copy this file to .env and fill in real values. Never commit .env.

# Django secret key (any long random string)
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local: SQLite. Prod: postgres://user:pass@host:5432/db or mysql://user:pass@host:3306/db
DATABASE_URL=sqlite:///db.sqlite3

# Encryption key for stored files. LOSING THIS KEY MEANS LOSING ALL FILES.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# React dev server URL (for CORS)
FRONTEND_URL=http://localhost:5173

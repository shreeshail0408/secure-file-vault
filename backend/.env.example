# Copy this file to .env and fill in real values. Never commit .env.

# Django secret key: a long random string.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# True only on your own machine. Production: False (turns on HTTPS redirect,
# secure cookies and HSTS; see config/settings.py).
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local: SQLite (relative paths are inside backend/).
# Optional MySQL: mysql://user:password@host/dbname (pip install mysqlclient)
DATABASE_URL=sqlite:///db.sqlite3

# Encryption key for stored files. LOSING THIS KEY MEANS LOSING ALL FILES.
# Keep a copy somewhere safe (password manager), outside the server.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# React dev server URL (for CORS). Not needed in production (same origin).
FRONTEND_URL=http://localhost:5173

# --- Production only (see DEPLOY.md) ---
# CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
# NUM_PROXIES=1                 # PythonAnywhere has one proxy in front of Django
# SECURE_HSTS_SECONDS=3600      # raise to 31536000 once HTTPS works
